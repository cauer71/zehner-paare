/**
 * Cloudflare Workers: Zehner-Paare als reine Datei-Auslieferung.
 *
 * Das Spiel ist eine statische Seite ohne Build-Schritt - es gibt also auch
 * hier kein "main"-Skript, nur "assets". Cloudflare liefert die Dateien dann
 * direkt aus, ohne dass ein Worker davor laeuft.
 *
 * Ausgeliefert wird dist/ und nicht der Projektordner. Der Grund steht in
 * tools/build-dist.mjs: wrangler legt sein eigenes .wrangler/ mitten hinein
 * und dreht sich dann beim lokalen Server endlos im Kreis - und Werkzeuge,
 * Tests und README haben auf der Spielseite ohnehin nichts verloren.
 *
 * Der Ordner entsteht mit "npm run build". Genau das gehoert bei Cloudflare
 * in das Feld "Build command"; im Feld "Deploy command" steht
 * "npx wrangler deploy".
 *
 * Die Domain haengt man im Dashboard an den Worker (Settings -> Domains &
 * Routes -> Add -> Custom domain). Sie steht bewusst nicht hier: dann kann
 * man sie aendern, ohne den Code anzufassen.
 */
{
  "name": "zehner-paare",
  "compatibility_date": "2025-09-01",

  // Seit der Weltrangliste in D1 liegt, steht ein Skript davor. Es beantwortet
  // /api/* und reicht alles andere an die Dateien weiter.
  "main": "worker.js",

  "d1_databases": [
    {
      // Die Bindung heisst weiter DB - im Skript aendert sich dadurch nichts.
      "binding": "DB",
      // EINE Datenbank fuer alle Spiele, nicht mehr eine je Spiel.
      //
      // Der kostenlose Tarif von D1 zaehlt DATENBANKEN, und zehn sind das
      // Limit - nicht Tabellen, nicht Zeilen, nicht Megabyte. Hier entsteht
      // etwa alle vier Tage ein neues Spiel; mit einer eigenen Datenbank je
      // Spiel waere die Grenze in wenigen Wochen erreicht gewesen, und zwar an
      // einer Zahl, die mit dem tatsaechlichen Verbrauch nichts zu tun hat:
      // alle Ranglisten zusammen sind ein paar Dutzend Zeilen. Verworfen wurde
      // der kostenpflichtige Tarif - fuer ein paar Dutzend Zeilen zu zahlen
      // waere die falsche Antwort auf eine Grenze, die gar nicht am
      // Datenvolumen haengt.
      //
      // Bezahlt wird das mit dem Praefix "zehner_" vor jedem Tabellen- und
      // Indexnamen. Der loest zwei ECHTE Zusammenstoesse, keine gedachten:
      // "zaehler" hiess die Tabelle hier UND bei Shikaku, beide mit den Zeilen
      // 'spiele' und 'siege' - in einer gemeinsamen Datenbank haetten die zwei
      // Spiele einander hochgezaehlt. Und Indexnamen sind in SQLite je
      // DATENBANK eindeutig und nicht je Tabelle, ein zweites
      // "rekorde_bestenliste" waere beim Anlegen abgewiesen worden. Der
      // Praefix kostet nichts und macht an jeder Abfrage sichtbar, zu welchem
      // Spiel eine Tabelle gehoert.
      "database_name": "spiele",
      // Kein Geheimnis: die ID benennt die Datenbank nur, sie oeffnet sie
      // nicht. Wer sie lesen oder schreiben will, braucht ein Token des
      // Kontos - darum steht sie hier und nicht in den Secrets.
      "database_id": "b82cb4dd-a307-4d2e-adb8-d20c98117ee2",
      // Gehoert in die Bindung und nicht auf die oberste Ebene - dort meldet
      // wrangler es als unbekanntes Feld und ignoriert es stillschweigend.
      "migrations_dir": "migrations"
    }
  ],

  "assets": {
    "directory": "./dist",
    // Damit das Skript die Dateien selbst ausliefern kann, statt dass etwas
    // dazwischen raet, was Datei ist und was Schnittstelle.
    "binding": "ASSETS",
    // Eine einzelne Seite ohne eigene Adressen: was es nicht gibt, ist ein
    // 404 und keine stillschweigende Umleitung auf index.html.
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  }
}
